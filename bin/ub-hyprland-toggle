#!/bin/bash

# ub:summary=Toggle permanent Hyprland flags by copying them into a directory that's sourced entirely.
# ub:args=[--enabled-notification <text>] [--disabled-notification <text>] <flag-name>

ENABLED_NOTIFICATION=""
DISABLED_NOTIFICATION=""

while [[ $# -gt 1 ]]; do
  case $1 in
    --enabled-notification) ENABLED_NOTIFICATION="$2"; shift 2 ;;
    --disabled-notification) DISABLED_NOTIFICATION="$2"; shift 2 ;;
    *) break ;;
  esac
done

FLAG_NAME="$1"
FLAG="$HOME/.local/state/ubuntu/toggles/hypr/$FLAG_NAME.lua"
FLAG_SOURCE="$UBUNTU_PATH/default/hypr/toggles/$FLAG_NAME.lua"

if [[ -f $FLAG ]]; then
  rm $FLAG
  [[ -n $DISABLED_NOTIFICATION ]] && ub-notification-send "" "$DISABLED_NOTIFICATION"
elif [[ -f $FLAG_SOURCE ]]; then
  mkdir -p "$(dirname $FLAG)"
  cp $FLAG_SOURCE $FLAG
  [[ -n $ENABLED_NOTIFICATION ]] && ub-notification-send "" "$ENABLED_NOTIFICATION"
else
  echo "Flag not found: $FLAG_NAME"
  exit 1
fi

hyprctl reload
