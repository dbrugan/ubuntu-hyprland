#!/bin/bash

# ub:summary=Control the Ubuntu menu (toggle / summon / close / refresh)
# ub:args=[toggle|summon|close|refresh|ping] [route]
# ub:examples=ub menu | ub menu toggle system | ub menu summon setup.power | ub menu refresh

# Thin wrapper around the shell's menu plugin IPC. Routes are item ids from
# default/ubuntu/ubuntu-menu.jsonc, passed as a JSON payload.

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  jq -nc --arg menu "$1" '{ menu: $menu }'
}

case "$verb" in
  toggle)
    exec ub-shell shell toggle ubuntu.menu "$(menu_payload "$route")"
    ;;
  summon)
    exec ub-shell shell summon ubuntu.menu "$(menu_payload "$route")"
    ;;
  close)
    exec ub-shell shell hide ubuntu.menu
    ;;
  refresh | ping)
    exec ub-shell shell call ubuntu.menu "$verb" "{}"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: ub menu [verb] [route]

Verbs:
  toggle [route]   Open the menu at <route>, or close it if already open. Default verb.
  summon [route]   Always open the menu (no close-if-visible toggle).
  close            Close the menu if it is visible.
  refresh          Re-parse the menu JSONC files.
  ping             Health check.

Route is an item id (e.g. setup.power) or alias (e.g. power). Defaults to
"root", which opens the top-level menu.
USAGE
    exit 0
    ;;
  *)
    echo "ub-menu: unknown verb '$verb'. Try 'ub menu --help'." >&2
    exit 2
    ;;
esac