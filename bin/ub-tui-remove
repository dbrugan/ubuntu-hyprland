#!/bin/bash

# ub:summary=Remove terminal UI desktop launchers
# ub:args=[name...]

set -e

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications/"

if (( $# == 0 )); then
  TUIS=()
  while IFS= read -r -d '' file; do
    if grep -qE '^Exec=xdg-terminal-exec --app-id=TUI\.' "$file"; then
      TUIS+=("$(basename "${file%.desktop}")")
    fi
  done < <(find "$DESKTOP_DIR" -name '*.desktop' -print0)

  if (( ${#TUIS[@]} == 0 )); then
    echo "No TUIs to remove."
    exit 1
  fi

  IFS=$'\n' SORTED_TUIS=($(sort <<<"${TUIS[*]}"))
  unset IFS
  APP_NAMES_STRING=$(gum choose --no-limit --header "Select TUI to remove..." --selected-prefix="✗ " "${SORTED_TUIS[@]}")
  APP_NAMES=()
  while IFS= read -r line; do
    [[ -n $line ]] && APP_NAMES+=("$line")
  done <<<"$APP_NAMES_STRING"
else
  # Array form so names containing spaces survive
  APP_NAMES=("$@")
fi

if (( ${#APP_NAMES[@]} == 0 )); then
  echo "You must provide TUI names."
  exit 1
fi

for APP_NAME in "${APP_NAMES[@]}"; do
  rm -f "$DESKTOP_DIR/$APP_NAME.desktop"
  rm -f "$ICON_DIR/$APP_NAME.png"
  echo "Removed $APP_NAME"
done

update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
