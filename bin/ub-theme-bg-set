#!/bin/bash

# ub:summary=Set the current background image
# ub:args=<path-to-image>
# ub:examples=ub theme bg set ~/Pictures/wallpaper.png

if [[ -z $1 ]]; then
  echo "Usage: ub-theme-bg-set <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"
CURRENT_BACKGROUND_LINK="$HOME/.config/ubuntu/current/background"

if [[ ! -f $BACKGROUND ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

# Create symlink to the new background. ub-theme-set normally creates this
# directory on its way through, but this command can be run on its own.
mkdir -p "$(dirname "$CURRENT_BACKGROUND_LINK")"
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# The shell's background plugin owns the wallpaper now, so it is told to set
# the new image rather than left to notice the symlink itself. set() cross-fades.
ub-shell -q background set "$BACKGROUND" >/dev/null 2>&1 || ub-shell -q background refresh >/dev/null 2>&1 || true
