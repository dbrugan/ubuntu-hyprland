#!/bin/bash

# ub:summary=Overwrite the user Hyprland Lua configs in ~/.config/hypr with the shipped defaults.

UBUNTU_SHARE="${UBUNTU_PATH:-$HOME/.local/share/ubuntu-hyprland}"

ub-refresh-config hypr/.luarc.json
ub-refresh-config hypr/autostart.lua
ub-refresh-config hypr/bindings.lua
ub-refresh-config hypr/input.lua
ub-refresh-config hypr/looknfeel.lua
ub-refresh-config hypr/hyprland.lua
ub-refresh-config hypr/monitors.lua
ub-refresh-config hypr/xdph.conf

mkdir -p ~/.local/state/ubuntu/toggles/hypr
cp "$UBUNTU_SHARE/default/hypr/toggles/flags.lua" ~/.local/state/ubuntu/toggles/hypr/
