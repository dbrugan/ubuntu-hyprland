#!/bin/bash

# ub:summary=Show the current monospace font
# ub:examples=ub font current

# Alacritty's config is what ub-font-set writes, so it is the reference.
if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  current=$(grep -oP '^\s*family\s*=\s*"\K[^"]+' ~/.config/alacritty/alacritty.toml | head -n1)
  if [[ -n $current ]]; then
    echo "$current"
    exit 0
  fi
fi

echo "Unknown"