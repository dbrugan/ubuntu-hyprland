#!/bin/bash

# ub:summary=Adjust the output volume and show the OSD
# ub:args=<raise|lower|mute-toggle|+N|-N>
# ub:examples=ub audio output volume raise | ub audio output volume lower | ub audio output volume mute-toggle | ub audio output volume +1

# Ported from upstream, which resolves the physical sink through a chain of
# audio helpers before touching pactl. This port has no DSP-routing layer to
# resolve through, so the default sink is the one the keys mean.

action="${1:-}"

if [[ -z $action ]]; then
  echo "Usage: $(basename "$0") <raise|lower|mute-toggle|+N|-N>"
  exit 1
fi

sink="@DEFAULT_SINK@"

volume_percent() {
  pactl get-sink-volume "$sink" 2>/dev/null |
    awk 'NR == 1 {
      for (i = 1; i <= NF; i++)
        if ($i ~ /%$/) {sub("%", "", $i); print $i; exit}
    }'
}

volume_muted() {
  [[ $(pactl get-sink-mute "$sink" 2>/dev/null) == *yes ]]
}

case "$action" in
  raise) action="+5" ;;
  lower) action="-5" ;;
esac

if [[ $action == "mute-toggle" ]]; then
  # A held key repeats, which would toggle mute straight back. Upstream
  # debounces on a state file; this does the same under the ubuntu state dir.
  debounce_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ubuntu"
  debounce_file="$debounce_dir/audio-output-volume-mute-toggle.last"
  mkdir -p "$debounce_dir"

  now=$(date +%s%3N)
  last=0
  [[ -r $debounce_file ]] && read -r last <"$debounce_file" || true
  if ((now - last < 250)); then
    exit 0
  fi
  printf '%s\n' "$now" >"$debounce_file"

  pactl set-sink-mute "$sink" toggle
elif [[ $action =~ ^([+-])([0-9]+)$ ]]; then
  direction="${BASH_REMATCH[1]}"
  step="${BASH_REMATCH[2]}"

  current="$(volume_percent)"
  if [[ -z $current ]]; then
    echo "Could not read volume for $sink." >&2
    exit 1
  fi

  if [[ $direction == "+" ]]; then
    next=$((current + step))
    ((next <= 100)) || next=100
  else
    next=$((current - step))
    ((next >= 0)) || next=0
  fi

  pactl set-sink-mute "$sink" 0
  pactl set-sink-volume "$sink" "${next}%"
else
  echo "Unknown volume action: $action"
  exit 1
fi

percent=$(volume_percent)
if volume_muted || ((${percent:-0} == 0)); then
  icon="volume-muted"
else
  icon="volume-high"
fi

ub-osd -i "$icon" -p "${percent:-0}"