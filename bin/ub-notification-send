#!/bin/bash

# ub:summary=Send a desktop notification with glyph and body spacing
# ub:args=<glyph> <headline> [description] [notify-send options]
# ub:examples=ub notification send "󰔛" "Reminder" "5 minutes are up" -u critical

set -euo pipefail

if (($# < 2)); then
  echo "Usage: $0 <glyph> <headline> [description] [notify-send options]"
  exit 1
fi

glyph=$1
headline=$2
description=${3:-}
shift 2

if (($# > 0)) && [[ $1 != -* ]]; then
  shift
else
  description=""
fi

summary="$headline"
[[ -n $glyph ]] && summary="$glyph    $headline"

if [[ -n $description ]]; then
  description=$(sed 's/^/      /' <<<"$description")
  notify-send "$@" "$summary" "$description"
else
  notify-send "$@" "$summary"
fi