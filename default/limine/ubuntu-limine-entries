#!/bin/bash

# Regenerate the kernel entries in /boot/limine.conf for installed UKIs.
#
# Stands in for upstream's limine-entry-tool, which is not ported here: its
# automation targets mkinitcpio/dracut plus pacman transactions, and Ubuntu uses
# initramfs-tools plus dpkg hooks. This script owns the OS entry and one child
# entry per UKI; limine-snapper-sync owns the Snapshots submenu.
#
# Entries live between the BEGIN/END markers below so repeated runs replace this
# block instead of appending duplicates, and leave the Snapshots submenu (which
# the sync tool rewrites on its own schedule) untouched.
#
# Called from install/login/limine-snapper.sh and from the UKI postinst hook in
# /etc/kernel/postinst.d/zz-ubuntu-ukify.

LIMINE_CONF="/boot/limine.conf"
UKI_DIR="/boot/EFI/Linux"
BEGIN_MARKER="# BEGIN ubuntu-limine-entries"
END_MARKER="# END ubuntu-limine-entries"

[[ -f $LIMINE_CONF ]] || exit 0
[[ -d $UKI_DIR ]] || exit 0

# Cmdline every entry shares. Empty is fine: Limine boots the UKI, which has a
# .cmdline section of its own.
cmdline=""
if [[ -f /etc/default/limine ]]; then
  cmdline=$(sed -n 's/^KERNEL_CMDLINE\[default\]+="\(.*\)"$/\1/p' /etc/default/limine | paste -sd' ' -)
fi

entries="$BEGIN_MARKER
/+Ubuntu
### This OS entry is auto-generated by ubuntu-limine-entries"

# One entry per UKI, newest first. Skip the .unsigned.efi and .signed.efi
# artifacts ukify leaves behind, and anything not named for this distro.
while IFS= read -r uki; do
  name=$(basename "$uki")
  version="${name#ubuntu_}"
  version="${version%.efi}"

  # Strip the ukify signing suffix from the version so the label is a kernel
  # version rather than an artifact name.
  version="${version%.unsigned}"
  version="${version%.signed}"

  entries+="
  //linux-$version
  comment: Kernel version: $version
  protocol: efi
  path: boot():/EFI/Linux/$name"

  if [[ -n $cmdline ]]; then
    entries+="
  cmdline: $cmdline"
  fi
done < <(find "$UKI_DIR" -maxdepth 1 -name 'ubuntu_*.efi' ! -name '*.unsigned.efi' ! -name '*.signed.efi' -type f | sort -Vr)

entries+="
$END_MARKER"

# Replace the managed block, or append it when absent.
if grep -qF "$BEGIN_MARKER" "$LIMINE_CONF"; then
  awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" -v block="$entries" '
    $0 == begin   { print block; skip = 1; next }
    $0 == end     { skip = 0; next }
    !skip         { print }
  ' "$LIMINE_CONF" >"$LIMINE_CONF.new"
else
  cat "$LIMINE_CONF" >"$LIMINE_CONF.new"
  printf '\n%s\n' "$entries" >>"$LIMINE_CONF.new"
fi

mv "$LIMINE_CONF.new" "$LIMINE_CONF"