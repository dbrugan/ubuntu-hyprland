[Unit]
Description=Recover the internal monitor toggle when no external display is connected
Before=graphical-session-pre.target
ConditionPathExists=%h/.local/state/ubuntu-hyprland/toggles/hypr/internal-monitor-disable.conf

[Service]
Type=oneshot
ExecStart=%h/.local/share/ubuntu-hyprland/bin/ub-hw-recover-internal-monitor

[Install]
WantedBy=graphical-session-pre.target