#!/bin/bash

# ub:summary=Reinstall the Walker autostart and restart config, relink the elephant menus, and restart the launcher.
# ub:examples=ub refresh walker

UBUNTU_SHARE="${UBUNTU_PATH:-$HOME/.local/share/ubuntu-hyprland}"

# Walker and the elephant menus are installed from default/ rather than
# config/, so ub-refresh-config cannot express them. This re-runs the same
# install step instead, which is the authoritative version of that layout.
bash "$UBUNTU_SHARE/install/config/walker-elephant.sh"

systemctl --user daemon-reload

ub-restart-walker