#!/bin/bash

# ub:summary=Set the system monospace font
# ub:args=<font-name>
# ub:examples=ub font list | ub font set "JetBrainsMono Nerd Font"

font_name="$1"

if [[ -z $font_name ]]; then
  echo "Usage: $(basename "$0") <font-name>"
  exit 1
fi

if ! fc-list | grep -iq "$font_name"; then
  echo "Font '$font_name' not found."
  exit 1
fi

if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  sed -i "s/family = \".*\"/family = \"$font_name\"/g" ~/.config/alacritty/alacritty.toml
fi

if [[ -f ~/.config/hypr/hyprlock.conf ]]; then
  sed -i "s/font_family = .*/font_family = $font_name/g" ~/.config/hypr/hyprlock.conf
fi

if [[ -f ~/.config/swayosd/style.css ]]; then
  sed -i "s/font-family: .*/font-family: '$font_name';/g" ~/.config/swayosd/style.css
fi

# The shell bar reads its font from shell.toml, which is rendered with the
# theme rather than edited in place, so there is nothing to rewrite here yet.

# Alacritty and swayosd need an explicit restart to pick the family up.
if [[ -f ~/.config/swayosd/style.css ]]; then
  ub-restart-swayosd
fi

ub-hook font-set "$font_name"