#!/bin/bash

# ub:summary=Enable, disable, or toggle the touch functionality of the screen
# ub:args=[on|off|toggle]

# The device name is stored as data, not config: a Lua file could execute it.
DEVICE_STATE="$HOME/.local/state/ubuntu/toggles/hypr/touchscreen-disabled-name"

device="$(ub-hw-touchscreen)"

if [[ -z $device ]]; then
  echo "No touchscreen device found" >&2
  exit 1
fi

enable() {
  hyprctl keyword "device[$device]:enabled" true >/dev/null
  rm -f "$DEVICE_STATE"
  ub-osd -i touchscreen -m "Touchscreen enabled"
}

disable() {
  hyprctl keyword "device[$device]:enabled" false >/dev/null
  mkdir -p "$(dirname "$DEVICE_STATE")"
  printf '%s\n' "$device" >"$DEVICE_STATE"
  ub-osd -i touchscreen -m "Touchscreen disabled"
}

case "${1:-toggle}" in
on) enable ;;
off) disable ;;
toggle) if [[ -f $DEVICE_STATE ]]; then enable; else disable; fi ;;
esac