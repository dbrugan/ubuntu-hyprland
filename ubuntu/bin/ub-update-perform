#!/bin/bash

# ub:summary=Run the full update pipeline
# ub:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

ub-update-system-pkgs
ub-update-pacstall
ub-update-orphan-pkgs
ub-hook post-update

ub-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
