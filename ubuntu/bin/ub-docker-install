#!/bin/bash

# ub:summary=Install Docker Engine from Docker's official apt repository
# ub:requires-sudo=true

if ub-cmd-present docker; then
  exit 0
fi

# Remove conflicting packages before installing Docker's bundled versions
conflicts=$(dpkg --get-selections 2>/dev/null |
  grep -E "^(docker\.io|docker-compose|docker-compose-v2|docker-doc|docker-buildx|podman-docker|containerd|runc)\s" |
  awk '{print $1}')

if [[ -n $conflicts ]]; then
  sudo apt remove -y $conflicts
fi

# Add Docker's official GPG key
sudo apt update
sudo apt -y install ca-certificates curl
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc

# Add the repository to apt sources, resolving the codename from os-release
codename=$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")

sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $codename
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

sudo apt update
sudo apt -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# Allow the current user to talk to the daemon without sudo
sudo usermod -aG docker "$USER"