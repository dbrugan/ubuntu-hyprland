#!/bin/bash

# ub:summary=Check whether the repo has commits we do not have yet
# ub:hidden=true

UBUNTU_SHARE="${UBUNTU_PATH:-$HOME/.local/share/ubuntu-hyprland}"

local_head=$(git -C "$UBUNTU_SHARE" rev-parse HEAD 2>/dev/null)
if [[ -z $local_head ]]; then
  echo "Error: could not read the local revision."
  exit 1
fi

remote_head=$(git -C "$UBUNTU_SHARE" ls-remote origin HEAD 2>/dev/null | awk '{print $1}')
if [[ -z $remote_head ]]; then
  echo "Error: could not retrieve the remote revision."
  exit 1
fi

if [[ $local_head != "$remote_head" ]]; then
  echo "Ubuntu Hyprland update available (${local_head:0:7} -> ${remote_head:0:7})"
  exit 0
else
  echo "Ubuntu Hyprland is up to date (${local_head:0:7})"
  exit 1
fi
