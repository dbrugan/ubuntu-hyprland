#!/bin/bash

# ub:summary=Prompt for text input with Walker
# ub:group=menu
# ub:name=input
# ub:args=prompt [walker args...]
# ub:examples=ub menu input Reminder

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

ub-launch-walker --dmenu --inputonly --width 295 --minheight 1 --maxheight 1 -p "$prompt…" "$@" 2>/dev/null
