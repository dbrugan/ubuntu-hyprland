#!/bin/bash

# ub:summary=Lock the computer and turn off the display
# ub:group=system
# ub:name=lock
# ub:examples=ub system lock

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    ub-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Avoid running screensaver when locked
pkill -f org.ubuntu.screensaver

if [[ ${UBUNTU_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    ub-brightness-keyboard off
    ub-brightness-display off
  ) &
fi
