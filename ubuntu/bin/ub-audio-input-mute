#!/bin/bash

# ub:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if pactl get-source-mute @DEFAULT_SOURCE@ | rg -q 'yes'; then
  led=on
  osd_message='Microphone muted'
  osd_icon='microphone-muted'
else
  led=off
  osd_message='Microphone on'
  osd_icon='microphone'
fi

ub-brightness-keyboard-mute "$led"

ub-osd \
  -m "$osd_message" \
  -i "$osd_icon"
