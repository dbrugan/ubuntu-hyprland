#!/bin/bash

# ub:summary=Display brightness level using SwayOSD on the current monitor.
# ub:args=<0-100>
# ub:examples=ub swayosd brightness 0 | ub swayosd brightness 50 | ub swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

ub-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
