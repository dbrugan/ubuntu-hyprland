#!/bin/bash

# ub:summary=Install a hook into ~/.config/ubuntu/hooks/<type>.d/
# ub:group=hook
# ub:name=install
# ub:args=<type> <file>
# ub:examples=ub hook install post-update ~/my-hook

set -e

if (( $# != 2 )); then
  echo "Usage: $(basename "$0") <type> <file>"
  exit 1
fi

HOOK_TYPE=$1
HOOK_FILE=$2
HOOK_DIR="$HOME/.config/ubuntu/hooks/$HOOK_TYPE.d"
HOOK_PATH="$HOOK_DIR/$(basename "$HOOK_FILE")"

if [[ ! -f $HOOK_FILE ]]; then
  echo "Hook file not found: $HOOK_FILE"
  exit 1
fi

mkdir -p "$HOOK_DIR"
cp "$HOOK_FILE" "$HOOK_PATH"
chmod 755 "$HOOK_PATH"

echo "Installed $HOOK_TYPE hook: $HOOK_PATH"
