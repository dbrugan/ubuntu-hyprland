#!/bin/bash

# ub:summary=Log out after closing application windows
# ub:examples=ub logout | ub system logout

# Detached from the terminal so it survives the windows closing below
nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

ub-hyprland-window-close-all
sleep 1 # Allow apps like Firefox to shut down correctly
