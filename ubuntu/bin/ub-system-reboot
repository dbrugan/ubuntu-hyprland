#!/bin/bash

# ub:summary=Reboot after closing application windows
# ub:examples=ub reboot | ub system reboot

ub-state clear re*-required

# Detached from the terminal so it survives the windows closing below
nohup bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 &

ub-hyprland-window-close-all
sleep 1 # Allow apps like Firefox to shut down correctly
